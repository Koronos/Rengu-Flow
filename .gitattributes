# Normalize line endings in the repo and, critically, force LF on shell scripts and the
# `rengu` launcher so they execute under WSL/Linux even when the repo is checked out on
# Windows (autocrlf would otherwise produce CRLF and `./rengu` fails with
# `/usr/bin/env: 'bash\r': No such file or directory`).
* text=auto

*.sh   text eol=lf
rengu  text eol=lf
*.py   text eol=lf
*.toml text eol=lf
*.md   text eol=lf

# Binary assets must never be normalized.
*.safetensors binary
*.pt          binary
*.ckpt        binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.gif         binary

# Model assets (tokenizers, configs, templates) are byte-exact copies of release files: never
# normalize their line endings (a CRLF checkout changes the bytes, and with them tokenization).
rengu_flow/model/**/assets/** -text
