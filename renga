#!/usr/bin/env bash
# Run renga via uv-managed .venv (install uv: https://docs.astral.sh/uv/)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
VENV="$ROOT/.venv"
RENGA="$VENV/bin/renga"

if ! command -v uv >/dev/null 2>&1; then
  echo "renga: uv is required. Install from https://docs.astral.sh/uv/" >&2
  exit 1
fi

if [[ ! -x "$RENGA" ]]; then
  echo "==> Setting up project environment (uv sync)..."
  uv sync
fi

exec "$RENGA" "$@"
