# Supply-chain hardening: pin exact versions and never widen them.
# `npm install <pkg>` records the exact resolved version (no ^/~ ranges), so a malicious
# minor/patch release cannot be pulled in. Installs/builds must use `npm ci` (lockfile-frozen,
# verifies integrity hashes) — `npm ci` aborts if package.json and package-lock.json disagree.
save-exact=true
save-prefix=
