# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Packaging / install artifacts
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Secrets and local env (legacy .env; prefer rengu.local.toml)
.env
.env.local
rengu.local.toml

# Web UI local state (configs library, jobs.db, staging, logs)
.rengu-flow-ui/
.renga-flow-ui/

# Installer state (recorded optional profiles for self-heal)
.rengu-flow/

# Local scratch (datasets, smoke configs, run output)
tmp/

# Training runs and exports (output_dir default)
output/

# Dataset caches (default root: cache/; legacy per-directory paths)
/cache/
**/cache/

# Logs and experiment trackers
*.log
wandb/
runs/
tensorboard/

# IDE / OS (Cursor: agents, rules, skills, debug logs — local only; not for collaborators)
.cursor/
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# DeepSpeed / torch artifacts in cwd
.zero/
*.pt.tmp

# Large local checkpoints (keep examples as path placeholders only)
*.safetensors
*.ckpt
*.pth
!examples/**
