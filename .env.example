# Copy to `.env` in the repo root (gitignored). Used by training and smoke scripts.
# Paths must exist on your machine. Quote values if they contain spaces.

# SDXL (examples/smoke_sdxl.toml, LoRA configs with checkpoint_path omitted)
RENGA_SDXL_CHECKPOINT_PATH=/path/to/sdxl.safetensors

# Cosmos Predict2 (examples/smoke_cosmos_predict2.toml)
RENGA_COSMOS_TRANSFORMER_PATH=/path/to/transformer.safetensors
RENGA_COSMOS_VAE_PATH=/path/to/qwen_image_vae.safetensors
RENGA_COSMOS_LLM_PATH=/path/to/qwen_3_06b_base.safetensors

# Optional: same vars work for any TOML — env overrides [model] paths when set.
