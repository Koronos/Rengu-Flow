# rengu.local.toml.example — copy to rengu.local.toml (repo root).
# Model checkpoints: set paths in your training TOML under [model], not here.

[ui]
host = "127.0.0.1"
port = 8765
# UI state (jobs.db, staging, logs) — a visible, git-ignored folder at the repo root so you can
# find and delete it. Leave as "data" unless you want it elsewhere (absolute paths allowed).
data_dir = "data"
# token = "change-me"

[maintenance]
enabled = false
allow_pip = false

# Defaults for `rengu train` (DeepSpeed launcher + trainer CLI).
# CLI flags override these values.
[training]
num_gpus = 1
master_port = 29500
# Space-separated args passed to rengu_flow.main after --config
extra_args = ""

# Training subprocess environment (literal os.environ keys; all values are strings).
# Default: empty — opt in per machine/GPU. See docs/user/cli.md
[training.env]
# Uncomment only what you need (consumer / RTX 40xx examples):
# NCCL_P2P_DISABLE = "1"
# NCCL_IB_DISABLE = "1"
# PYTORCH_CUDA_ALLOC_CONF = "expandable_segments:True"  # native Linux ONLY (see note)
# WSL2: leave PYTORCH_CUDA_ALLOC_CONF unset — expandable_segments crashes cuDNN conv on WSL
# ("device not ready"). rengu forces expandable_segments:False automatically on WSL.
# RENGU_TUNING_TF32_APPLY = "1"   # Ampere+ only; enables TF32 matmul/cudnn in rengu_flow.main
# CUDA_VISIBLE_DEVICES = "0"
